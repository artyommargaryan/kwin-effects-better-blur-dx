<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
    http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
    <kcfgfile arg="true"/>
    <group name="Effect-better-blur-dx">
        <!-- General -->
        <entry name="BlurStrength" type="Int">
            <default>15</default>
        </entry>
        <!-- local fork: separate blur strength for docks/panels, 0 = same as BlurStrength -->
        <entry name="DockBlurStrength" type="Int">
            <default>0</default>
        </entry>
        <entry name="NoiseStrength" type="Int">
            <default>5</default>
        </entry>
        <entry name="Brightness" type="Int">
            <default>100</default>
        </entry>
        <entry name="Saturation" type="Int">
            <default>150</default>
        </entry>
        <entry name="Contrast" type="Int">
            <default>100</default>
        </entry>
        <entry name="ForceContrastParams" type="Bool">
            <default>false</default>
        </entry>
        <entry name="CornerRadius" type="Double">
            <default>0.0</default>
        </entry>
        <!-- Force Blur -->
        <entry name="WindowClasses" type="String">
            <default>class1
class2
class3</default>
        </entry>
        <entry name="BlurMatching" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BlurNonMatching" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BlurDecorations" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BlurMenus" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BlurDocks" type="Bool">
            <default>false</default>
        </entry>
        <!-- Refraction -->
        <entry name="RefractionStrength" type="Int">
            <default>0</default>
        </entry>
        <entry name="RefractionMode" type="Int">
            <default>0</default>
        </entry>
        <entry name="RefractionEdgeSize" type="Int">
            <default>20</default>
        </entry>
        <entry name="RefractionNormalPow" type="Int">
            <default>2</default>
        </entry>
        <entry name="RefractionCornerRadius" type="Int">
            <default>8</default>
        </entry>
        <entry name="RefractionRGBFringing" type="Int">
            <default>1</default>
        </entry>
        <entry name="RefractionTextureRepeatMode" type="Int">
            <default>0</default>
        </entry>
        <!-- Glass (lens mode + lighting); sliders on the Glass tab of the settings page -->
        <!-- exact corner radii in px for the Glass mode lens/rim; 0 = fall back
             (GlassCornerRadius -> snapped RefractionCornerRadius, DockCornerRadius -> glass value) -->
        <entry name="GlassCornerRadius" type="Int">
            <default>0</default>
        </entry>
        <entry name="DockCornerRadius" type="Int">
            <default>0</default>
        </entry>
        <!-- application menus (Kvantum etc.) hand over a stepped blur shape with small corners.
             If > 0 the glass behind such menus is cut to a smooth rounded rectangle of this
             radius instead; the menu theme has to draw its frame with the same radius. 0 = off -->
        <entry name="MenuCornerRadius" type="Int">
            <default>0</default>
        </entry>
        <!-- strength (percent) of a thin, even light line drawn along the edge of menus that are
             cut to MenuCornerRadius. The directional rim light leaves two corners unlit; this line
             runs all the way round. 0 = off -->
        <entry name="MenuEdgeLine" type="Int">
            <default>0</default>
        </entry>
        <!-- adaptive dimming: backdrop luminance above the knee is compressed towards this
             ceiling (percent), darker areas are left alone. 100 = off -->
        <entry name="GlassLumaCeiling" type="Int">
            <default>100</default>
        </entry>
        <entry name="GlassIor" type="Int">
            <default>150</default>
        </entry>
        <entry name="GlassProfile" type="Int">
            <default>4</default>
        </entry>
        <entry name="RimStrength" type="Int">
            <default>0</default>
        </entry>
        <entry name="RimWidth" type="Int">
            <default>15</default>
        </entry>
        <entry name="RimLightAngle" type="Int">
            <default>225</default>
        </entry>
        <entry name="RimDirectionality" type="Int">
            <default>15</default>
        </entry>
        <entry name="RimBackStrength" type="Int">
            <default>45</default>
        </entry>
        <entry name="InnerShade" type="Int">
            <default>0</default>
        </entry>
        <entry name="InnerShadeRadius" type="Int">
            <default>12</default>
        </entry>
        <!-- Performance -->
        <entry name="BlitMode" type="Enum">
            <choices name="BBDX::BlitMode">
                <choice name="RENDER_TARGET"/>
                <choice name="WALLPAPER"/>
            </choices>
            <default>BlitMode::RENDER_TARGET</default>
        </entry>
        <entry name="BlurCacheIgnore" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BlurCacheRateLimit" type="Int">
            <default>33</default>
        </entry>
    </group>
</kcfg>
